{
  "name": "nomicon-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Enforcement agent for Nomicon: applies CONSTITUTION.md and LAWS.md to pull requests and writes the public ledger.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nomicon": "./dist/cli.js",
    "nomicon-pay": "./dist/payer.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay": "node dist/cli.js replay",
    "pay": "node dist/payer.js",
    "sim": "node dist/sim/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@coinbase/cdp-sdk": "^1.58.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "viem": "^2.57.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}

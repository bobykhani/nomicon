# Copy to /srv/nomicon/secrets/agent.env, mode 600. Paths below are inside the container.
GITHUB_OWNER=nomicon-world
GITHUB_REPO=nomicon
GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=        optional; resolved from the repository when unset
NOMICON_PUBLIC_URL=https://agent.example.org
NOMICON_NETWORK=eip155:8453
BASE_RPC_URL=https://mainnet.base.org
X402_FACILITATOR_URL=https://x402.org/facilitator
NOMICON_FEE_DESTINATION=0x
NOMICON_OWNER_ACCOUNTS=
# NOMICON_AGENT_ACCOUNT=            optional; genesis records the App's own id when unset
NOMICON_DOORBELL_ISSUE=
NOMICON_TICK_SECONDS=60
NOMICON_USDC_CAD=1.37
ANTHROPIC_API_KEY=
# ANCHOR_PRIVATE_KEY=0x             wallet that pays gas for ledger anchors, optional

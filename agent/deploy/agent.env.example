# Copy to /srv/nomicon/secrets/agent.env, mode 600. The compose file sets NOMICON_LEDGER_KEY and GITHUB_APP_PRIVATE_KEY
# to the key files mounted from /srv/nomicon/secrets (ledger.pem, github-app.pem); on a plain host set them here as paths.
GITHUB_OWNER=nomicon-world
GITHUB_REPO=nomicon
GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=        optional; resolved from the repository when unset
NOMICON_PUBLIC_URL=https://agent.example.org
NOMICON_NETWORK=eip155:8453
# A provider endpoint (Alchemy, QuickNode, Infura) is steadier than the public one under load.
BASE_RPC_URL=https://mainnet.base.org
# Mainnet settles through Coinbase's facilitator, which needs a CDP API key (first 1,000 settlements a month free, then $0.001 each).
# For a testnet, unset these two and set X402_FACILITATOR_URL=https://x402.org/facilitator instead.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# NOMICON_TAX_INCLUDED="HST 13% included"   shown on every quote once registered; unset means "none"
# NOMICON_TAX_REGISTRATION=                  the GST/HST registration number, shown on every quote
# Wallet that pays gas for anchoring the ledger head on Base at every fee adjustment (Article 11). Needs a little ETH on Base.
ANCHOR_PRIVATE_KEY=0x
NOMICON_FEE_DESTINATION=0x
NOMICON_OWNER_ACCOUNTS=            # numeric GitHub account ids, comma-separated
# NOMICON_AGENT_ACCOUNT=            optional; genesis records the App's own id when unset
NOMICON_DOORBELL_ISSUE=            # the issue number, not a URL
NOMICON_TICK_SECONDS=60
# NOMICON_USDC_CAD=1.37            fixed USD/CAD rate; unset to use the Bank of Canada daily rate (fallback 1.37)
ANTHROPIC_API_KEY=

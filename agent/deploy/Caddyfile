# TLS from Let's Encrypt for the agent's public address. Caddy sets
# X-Forwarded-For, which the agent trusts because NOMICON_TRUST_PROXY=1.
{$NOMICON_DOMAIN} {
	encode gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy agent:8402 {
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stderr
	}
}

# Owner-maintained sites that live only on the server (for example the contact page
# named in NOTICES.md), mounted from /srv/nomicon/sites. None is required.
import /etc/caddy/sites/*.caddy
